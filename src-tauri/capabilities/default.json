{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main Brain.fm window, including the remote my.brain.fm origin.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://my.brain.fm", "https://*.brain.fm"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus"
  ]
}
