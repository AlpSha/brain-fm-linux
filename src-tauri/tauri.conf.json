{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "brain-fm",
  "version": "0.1.0",
  "identifier": "fm.brain.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "AudioVideo",
    "shortDescription": "Brain.fm focus music, on your Linux desktop",
    "longDescription": "Unofficial desktop wrapper for the Brain.fm web player with media-key (MPRIS) support and a system tray.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
